# =============================================================================
# VidyaOS Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Server Port
PORT=3000
NODE_ENV=production

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Set DB_CLIENT to 'sqlite' for local development or 'mysql' for production

# --- Option A: Local SQLite (Zero-setup, for development only) ---
DB_CLIENT=sqlite
SQLITE_FILE=college_attendance.sqlite

# --- Option B: MySQL (Required for production on Render / cPanel / VPS) ---
# DB_CLIENT=mysql
# DB_HOST=your-mysql-host.com
# DB_PORT=3306
# DB_USER=vidyaos_user
# DB_PASSWORD=YourStrongPasswordHere
# DB_NAME=college_attendance
# DB_CONNECTION_LIMIT=10

# =============================================================================
# JWT SECURITY — GENERATE STRONG SECRETS BEFORE PRODUCTION
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================================
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_HEX_STRING
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# =============================================================================
# FILE STORAGE
# =============================================================================
# Directory for assignment attachments and student submissions
# Docker: /app/uploads  |  Render: ./uploads  |  Local: uploads/
UPLOADS_DIR=uploads

# =============================================================================
# WHATSAPP WEB BOT (OPTIONAL — for OTP and notification delivery)
# =============================================================================
# Session data directory (must persist across deployments / container rebuilds)
# Docker: /app/whatsapp_session  |  VPS: /opt/vidyaos/whatsapp_session
WHATSAPP_SESSION_DIR=whatsapp_session

# Chromium executable path (Linux/Docker only — set automatically from Playwright on Windows/Mac)
# Docker: PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_EXECUTABLE_PATH=

# =============================================================================
# OPERATIONAL PARAMETERS
# =============================================================================
# Minimum attendance percentage before a student appears on the defaulter report
DEFAULT_ATTENDANCE_THRESHOLD=75

# Interval in seconds for auto-closing expired attendance sessions
AUTO_CLOSE_CHECK_INTERVAL_SECONDS=60
