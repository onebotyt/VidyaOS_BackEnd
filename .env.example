# =============================================================================
# VidyaOS Backend — Pure MySQL 8.x / MariaDB Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your MySQL database credentials.

PORT=3000
NODE_ENV=production

# =============================================================================
# MYSQL DATABASE CONFIGURATION (Local MySQL / cPanel MySQL / Aiven Cloud SSL)
# =============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=college_attendance
DB_SSL=false
DB_CONNECTION_LIMIT=10

# --- For Aiven Cloud / TiDB / AWS RDS MySQL with SSL ---
# DB_HOST=mysql-instance.aivencloud.com
# DB_PORT=26368
# DB_USER=avnadmin
# DB_PASSWORD=your_cloud_password
# DB_NAME=defaultdb
# DB_SSL=true

# =============================================================================
# MASTER ADMINISTRATOR BOOTSTRAP
# =============================================================================
ADMIN_EMAIL=admin@gpnainital.ac.in
ADMIN_PASSWORD=ChangeMe Immediately2026!

# =============================================================================
# JWT SECURITY — GENERATE STRONG 64-BYTE HEX SECRETS
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================================
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_HEX_STRING
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# =============================================================================
# FILE STORAGE & OPERATIONAL PARAMETERS
# =============================================================================
UPLOADS_DIR=uploads
DEFAULT_ATTENDANCE_THRESHOLD=75
AUTO_CLOSE_CHECK_INTERVAL_SECONDS=60
